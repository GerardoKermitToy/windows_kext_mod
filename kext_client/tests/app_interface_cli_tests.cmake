# Parser tests use --help; preflight tests deliberately fail before netsh/SCM.
function(check_args expected)
    execute_process(
        COMMAND "${MONITOR}" --duration 1 ${ARGN} --help
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Args '${ARGN}': expected ${expected}, got ${result}\n${output}${error}")
    endif()
    if("${expected}" STREQUAL "0")
        foreach(text IN ITEMS "--app" "--interface" "--interface-luid" "IPv4 and IPv6 route policies" "nsi.lib" "through netsh" "Does not launch")
            if(NOT output MATCHES "${text}")
                message(FATAL_ERROR "Help does not document '${text}'")
            endif()
        endforeach()
    endif()
endfunction()

check_args(0)
check_args(2 --app "C:/Apps/example.exe")
check_args(2 --app)
check_args(2 --interface 76)
check_args(2 --interface-luid 1)
check_args(2 --app "C:/Apps/example.exe" --interface)
check_args(2 --app "C:/Apps/example.exe" --interface-luid)
foreach(value IN ITEMS "0" "-1" "+1" "4294967296" "18446744073709551616")
    check_args(2 --app "C:/Apps/example.exe" --interface "${value}")
endforeach()
foreach(value IN ITEMS "-1" "+1" "1x" "0x" "0xg" "0x10000000000000000" "18446744073709551616")
    check_args(2 --app "C:/Apps/example.exe" --interface-luid "${value}")
endforeach()
foreach(value IN ITEMS "0" "1" "18446744073709551615" "0x0" "0X1" "0xffffffffffffffff")
    check_args(0 --app "C:/Apps/example.exe" --interface-luid "${value}")
endforeach()
foreach(value IN ITEMS "76" "4294967295" "wg0" "Ethernet 2" "Адаптер Тест")
    check_args(0 --app "C:/Тест/Приложение_应用_é.exe" --interface "${value}")
endforeach()
check_args(2 --app one.exe --app two.exe --interface 76)
check_args(2 --app one.exe --interface 76 --interface 11)
check_args(2 --app one.exe --interface 76 --interface-luid 1)
check_args(2 --app one.exe --interface-luid 1 --interface 76)
check_args(2 --app one.exe --interface-luid 1 --interface-luid 2)

function(check_preflight expected_text)
    execute_process(
        COMMAND "${MONITOR}" --duration 1 ${ARGN} "${MONITOR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT "${result}" STREQUAL "1" OR NOT "${output}${error}" MATCHES "${expected_text}")
        message(FATAL_ERROR "Preflight '${ARGN}': unexpected result ${result}\n${output}${error}")
    endif()
    if("${output}${error}" MATCHES "IPv4/IPv6 route policies: enabled|Service is available|App interface:")
        message(FATAL_ERROR "Preflight '${ARGN}' proceeded past validation")
    endif()
endfunction()
check_preflight("existing file" --app "${CMAKE_CURRENT_BINARY_DIR}/definitely-missing-app.exe" --interface 76)
check_preflight("existing file" --app "${CMAKE_CURRENT_BINARY_DIR}" --interface 76)
check_preflight("cannot resolve the selected interface" --app "${MONITOR}" --interface "pmkext-no-such-interface-7e4d023a")
check_preflight("cannot resolve the selected interface" --app "${MONITOR}" --interface-luid 1)
check_preflight("cannot resolve the selected interface" --process-events-only --app "${MONITOR}" --interface "pmkext-no-such-interface-7e4d023a")
message(STATUS "PASS: app/interface CLI syntax, Unicode values and side-effect-free preflight")
